#!/bin/sh
# Gradle wrapper launcher.
# If gradle/wrapper/gradle-wrapper.jar is missing (it is a binary file), fall back to an
# installed Gradle. Running "gradle wrapper --gradle-version 8.10.2" once regenerates the
# jar and replaces this script with the official one.
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$JAR" ]; then
  if [ -n "$JAVA_HOME" ]; then JAVACMD="$JAVA_HOME/bin/java"; else JAVACMD=java; fi
  exec "$JAVACMD" -Dorg.gradle.appname=gradlew -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
elif command -v gradle >/dev/null 2>&1; then
  echo "gradle-wrapper.jar not found - using installed Gradle."
  exec gradle "$@"
else
  echo "ERROR: gradle-wrapper.jar is missing and Gradle is not installed."
  echo "Fix: open the backend folder in IntelliJ (it imports Gradle automatically),"
  echo "or install Gradle 8.x and run:  gradle wrapper --gradle-version 8.10.2"
  exit 1
fi
